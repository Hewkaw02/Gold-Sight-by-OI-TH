CME_EMAIL=
CME_PASSWORD=
# Optional host port for the Docker dashboard.
# DASHBOARD_PORT=8080
# Optional published GHCR images. Leave unset to build the local images.
# DASHBOARD_IMAGE=ghcr.io/OWNER/REPOSITORY:latest
# COLLECTOR_IMAGE=ghcr.io/OWNER/REPOSITORY-collector:latest
# Optional local browser session path. The default is safe to keep inside this project.
# CME_STORAGE_STATE_PATH=runtime/cme-storage-state.json
GOLD_SIGHT_DATA_ROOT=public/data
GOLD_SIGHT_SYMBOL=GC
TV_SOURCE_SYMBOL=GOLD.F
TV_SOURCE_EXCHANGE=BLACKBULL
TV_SOURCE_TIMEZONE=America/Chicago
PRICE_TIMEFRAMES=4H,1D
OI_TARGET_DTES=7,15,30
OI_SESSION_SLOTS=open,mid,close
OI_P90_QUANTILE=0.9
OI_MAX_GAP_TRADING_SESSIONS=2
DISPLAY_TIMEZONE=Asia/Bangkok
CME_TIMEZONE=America/Chicago
PRICE_1D_MAX_AGE_HOURS=72
PRICE_4H_MAX_AGE_HOURS=12
OI_MAX_BUSINESS_DAY_LAG=2
OPTIONS_RISK_FREE_RATE=0.04
GOLD_OPTION_CONTRACT_MULTIPLIER=100

# Local Docker scheduler. Price + Thai Gold run every 15 minutes on weekdays;
# CME OI runs at the three Chicago-time windows below.
SCHEDULER_RUN_ON_START=true
SCHEDULER_EXPIRY_SERIES_RUN_ON_START=true
SCHEDULER_POLL_SECONDS=30
SCHEDULER_PRICE_INTERVAL_MINUTES=15
SCHEDULER_PRICE_TIMEZONE=America/Chicago
SCHEDULER_OI_TIMEZONE=America/Chicago
SCHEDULER_OI_TIMES=07:50,09:55,12:20
SCHEDULER_OI_SLOTS=open,mid,close
SCHEDULER_OI_GRACE_MINUTES=2
SCHEDULER_EXPIRY_SERIES_TIMEZONE=America/Chicago
SCHEDULER_EXPIRY_SERIES_TIME=06:30
SCHEDULER_EXPIRY_SERIES_GRACE_MINUTES=5
